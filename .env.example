   # Copy this file to .env and fill in your Supabase project's values.
   # Find these in Supabase Dashboard → Project Settings → API.
   # The anon key is safe to ship in the client — access is controlled by the
   # Row Level Security policies in supabase/migrations/0001_init.sql.

   EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
   EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

   # Smartwaiver → My Account → Waivers → your waiver's public "Web Waiver"
   # URL. The app appends ?auto_tag=<user id> so smartwaiver-webhook can
   # match the signed waiver back to the right profile. Also requires, as
   # Supabase Edge Function secrets (not client env vars):
   #   SMARTWAIVER_WEBHOOK_SECRET  - shared secret in the webhook URL's
   #                                 ?secret= param, set in Smartwaiver's
   #                                 Webhooks page (Web Endpoint mode, not
   #                                 "V4 API Template Queue" -- that mode
   #                                 never pushes to our URL).
   #   SMARTWAIVER_API_KEY         - from Smartwaiver's API key page
   #                                 (different from the webhook's
   #                                 "private key"). The webhook ping only
   #                                 contains a bare waiver id, so we call
   #                                 back to Smartwaiver's REST API with it
   #                                 to fetch the signer's actual tag.
   EXPO_PUBLIC_SMARTWAIVER_WAIVER_URL=https://waiver.smartwaiver.com/v2/YOUR_TEMPLATE_ID/
