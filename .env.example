   # Copy this file to .env and fill in your Supabase project's values.
   # Find these in Supabase Dashboard → Project Settings → API.
   # The anon key is safe to ship in the client — access is controlled by the
   # Row Level Security policies in supabase/migrations/0001_init.sql.

   EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
   EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

   # Smartwaiver → My Account → Waivers → your waiver's public "Web Waiver"
   # URL. The app appends ?tag1=<user id> so smartwaiver-webhook can match
   # the signed waiver back to the right profile (see that function's
   # comments for the exact payload field it reads).
   EXPO_PUBLIC_SMARTWAIVER_WAIVER_URL=https://waiver.smartwaiver.com/v2/YOUR_TEMPLATE_ID/
