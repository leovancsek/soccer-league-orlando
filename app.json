{
  "expo": {
    "name": "Soccer League Orlando",
    "slug": "soccer-league-orlando",
    "scheme": "soccerleagueorlando",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.soccerleagueorlando.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Used to upload a photo of the field when creating a game listing."
      }
    },
    "android": {
      "package": "com.soccerleagueorlando.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12235A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#12235A"
        }
      ],
      "expo-localization"
    ]
  }
}
